{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.computron/fulltext-article-downloader",
  "description": "Full text of research papers by DOI, arXiv, PMC or OpenReview id, verified against the record",
  "repository": {
    "url": "https://github.com/computron/fulltext-article-downloader",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registry_type": "pypi",
      "identifier": "fulltext-article-downloader",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "runtime_hint": "uvx",
      "runtime_arguments": [
        {
          "type": "positional",
          "value": "--from",
          "is_required": true
        },
        {
          "type": "positional",
          "value": "fulltext-article-downloader[mcp]",
          "is_required": true
        },
        {
          "type": "positional",
          "value": "fulltext-mcp",
          "is_required": true
        }
      ],
      "environment_variables": [
        {
          "name": "UNPAYWALL_EMAIL",
          "description": "Contact email for Unpaywall and Crossref",
          "is_required": false
        },
        {
          "name": "FULLTEXT_OUTPUT_DIR",
          "description": "Folder for downloaded files (default ./papers)",
          "is_required": false
        },
        {
          "name": "WILEY_API_KEY",
          "description": "Wiley TDM token",
          "is_required": false,
          "is_secret": true
        },
        {
          "name": "ELSEVIER_API_KEY",
          "description": "Elsevier API key",
          "is_required": false,
          "is_secret": true
        },
        {
          "name": "SPRINGER_API_KEY",
          "description": "Springer Nature API key",
          "is_required": false,
          "is_secret": true
        },
        {
          "name": "SEMANTIC_SCHOLAR_API_KEY",
          "description": "Semantic Scholar API key",
          "is_required": false,
          "is_secret": true
        }
      ]
    }
  ]
}
